# Render Web Service Port (automatically set by Render)
PORT=3001

# Option 1: Link directly to your Render ai-receptionist backend API URL
BACKEND_API_URL=https://your-ai-receptionist.onrender.com
# Must match DASHBOARD_API_KEY set on ai-receptionist backend
BACKEND_API_KEY=your_dashboard_api_secret_key

# Option 2: Direct MongoDB Atlas connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
DB_NAME=ai_receptionist
COLLECTION_NAME=calllogs

# Dashboard Login Credentials
DASH_USER=admin
DASH_PASS=admin123
